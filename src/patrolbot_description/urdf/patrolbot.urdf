<?xml version="1.0"?>
<robot name="patrolbot">
 <link name="base_footprint"/>
 <link name="base_link"><visual><geometry><box size="0.40 0.26 0.15"/></geometry><material name="blue"><color rgba="0.1 0.3 0.8 1"/></material></visual><collision><geometry><box size="0.40 0.26 0.15"/></geometry></collision><inertial><origin xyz="0 0 0"/><mass value="8"/><inertia ixx="0.0607" ixy="0" ixz="0" iyy="0.1267" iyz="0" izz="0.1577"/></inertial></link>
 <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.125"/></joint>
 <link name="left_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision><inertial><mass value="0.3"/><inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.000135"/></inertial></link>
 <link name="right_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision><inertial><mass value="0.3"/><inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.000135"/></inertial></link>
 <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.15 -0.075"/><axis xyz="0 1 0"/><dynamics damping="0.1"/></joint><joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.15 -0.075"/><axis xyz="0 1 0"/><dynamics damping="0.1"/></joint>
 <link name="caster_link"><visual><geometry><sphere radius="0.035"/></geometry></visual><collision><geometry><sphere radius="0.035"/></geometry></collision><inertial><mass value="0.1"/><inertia ixx="0.000049" ixy="0" ixz="0" iyy="0.000049" iyz="0" izz="0.000049"/></inertial></link><joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="0.14 0 -0.105"/></joint>
 <link name="lidar_link"><visual><geometry><cylinder radius="0.04" length="0.05"/></geometry></visual><collision><geometry><cylinder radius="0.04" length="0.05"/></geometry></collision><inertial><mass value="0.15"/><inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00012"/></inertial></link><joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.08 0 0.115"/></joint>
 <link name="camera_link"><visual><geometry><box size="0.04 0.06 0.04"/></geometry></visual><collision><geometry><box size="0.04 0.06 0.04"/></geometry></collision><inertial><mass value="0.1"/><inertia ixx="0.000043" ixy="0" ixz="0" iyy="0.000027" iyz="0" izz="0.000043"/></inertial></link><joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.20 0 0.04"/></joint><link name="camera_optical_frame"/><joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="-1.5708 0 -1.5708"/></joint>
 <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo><gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo><gazebo reference="caster_link"><mu1>0.05</mu1><mu2>0.05</mu2></gazebo>
 <gazebo><plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so"><update_rate>50</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.30</wheel_separation><wheel_diameter>0.10</wheel_diameter><command_topic>/cmd_vel</command_topic><odometry_topic>/odom</odometry_topic><odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame><publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf><publish_wheel_joint_state>true</publish_wheel_joint_state><odometry_source>0</odometry_source></plugin></gazebo>
 <gazebo reference="lidar_link"><sensor name="lidar" type="ray"><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.1</min><max>10</max><resolution>0.01</resolution></range></ray><plugin name="laser" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>lidar_link</frame_name></plugin></sensor></gazebo>
 <gazebo reference="camera_link"><sensor name="camera" type="camera"><update_rate>10</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera><plugin name="camera" filename="libgazebo_ros_camera.so"><frame_name>camera_optical_frame</frame_name></plugin></sensor></gazebo>
</robot>
